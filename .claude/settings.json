{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-local-review.sh",
            "if": "Bash(gh pr create*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
